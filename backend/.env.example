# Online Attendance Management System Configuration
APP_ENV=development
APP_NAME="Online Attendance Management System"
SECRET_KEY=change-this-in-production-to-a-very-secure-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# For SQLite local development:
DATABASE_URL=sqlite:///./attendance.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/attendance_db

# Attendance calculation settings
DEFAULT_ATTENDANCE_THRESHOLD=75.0
ALLOW_HALF_DAY=true
HALF_DAY_WEIGHT=0.5

# Institution Details
INSTITUTION_NAME="Apex Institute of Technology"
ACADEMIC_YEAR="2025-2026"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
